> <span class=\"RightOpDesc\"> automation <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"Block","ID":"BL_5BIivynGLfqvfIW","FlowID":"FL_20","Autofill":[]}]},{"Type":"Branch","FlowID":"FL_19","Description":"New Branch","BranchLogic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"condition","Operator":"EqualTo","RightOperand":"suggestions","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">condition<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> suggestions <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"Flow":[{"Type":"Block","ID":"BL_8vujDCam5fBQrSm","FlowID":"FL_21","Autofill":[]}]},{"Type":"Standard","ID":"BL_0k3lJxQPMKMd698","FlowID":"FL_16","Autofill":[]}],"Properties":{"Count":23}}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Public","PreviewID":"3d760fd0-1ecb-4f22-bf64-ccd21e4bd538"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"49","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"RS","PrimaryAttribute":"RS_0V7B1T46Q033o90","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DisplayMessage","Header":"","Footer":"","ProgressBarDisplay":"None","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"","NextButton":"","SurveyTitle":"Qualtrics Survey | Qualtrics Experience Management","SkinLibrary":"uwa","SkinType":"component","Skin":{"brandingId":"739132846","templateId":"*simple","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","EOSMessage":"MS_idNaoIO51lFevKe","ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"false","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":"UR_cx3B7rHE4ltDXMy","EOSRedirectURL":"http:\/\/","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]},"ProtectSelectionIds":true}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"5. How concerned are you about your privacy online?","TertiaryAttribute":null,"Payload":{"QuestionText":"5. How concerned are you about your privacy online?","DefaultChoices":false,"DataExportTag":"","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"5. How concerned are you about your privacy online?","Choices":{"1":{"Display":"Not at all concerned"},"2":{"Display":"Slightly concerned"},"3":{"Display":"Moderately concerned"},"4":{"Display":"Very concerned"},"5":{"Display":"Extremely concerned"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"\u00a0 Participant Information and Consent Form Project Title: User interaction, Trust, and Privacy on..","TertiaryAttribute":null,"Payload":{"QuestionText":"<section class=\"participant-information\">\n<div style=\"margin-bottom: 24px;\">&nbsp;<\/div>\n\n<h1>Participant Information and Consent Form<\/h1><br>\n\n<p><b>Project Title:<\/b> User interaction, Trust, and Privacy on Websites<\/p>\n&nbsp;\n\n<p><b>Name of Researchers:<\/b> Dr Jin Hong (Senior Lecturer, School of Physics, Mathematics and Computing, Computer Science and Software Engineering), Dipika Choudhury (Bachelor of Philosophy Honours Student).<\/p>\n&nbsp;\n\n<p><b>Invitation:<\/b><\/p>\n\n<p><\/p><p><\/p>You are invited to participate in a research study examining how people interact with websites,\ninterpret common website features, and form impressions about website trust and privacy.<\/section><section class=\"participant-information\"><br><\/section><section class=\"participant-information\">If you agree to participate, you will complete a short questionnaire, undertake information-finding tasks on three mock websites, and complete a final questionnaire about your\nexperience. You will be randomly assigned to one of three versions of the website interfaces.\nParticipation is expected to take approximately 10-15 minutes.<\/section><section class=\"participant-information\"><br><\/section><section class=\"participant-information\">During the website tasks, the experiment environment will record your interactions within the\nmock websites, including pages viewed, mouse clicks, task responses, and the time taken to\nperform particular actions. Raw mouse movements, unrelated browser activity and activity\noutside the mock websites will not be recorded.<\/section><section class=\"participant-information\"><br><\/section><section class=\"participant-information\">Some details of the specific research question cannot be provided before participation because\nthis information could influence how people normally interact with the websites. A complete\nexplanation of the study will be provided after the experiment. At that time, you will have an\nopportunity to ask questions by contacting the researchers.<\/section><section class=\"participant-information\"><br><\/section><section class=\"participant-information\">\n\n<p><b>Voluntary Participation and Withdrawal from the Study:<\/b><\/p>\n\n<p><\/p><p>Participation in this study is voluntary. You may withdraw from the study at any time before\nsubmitting your responses, without giving an explanation and without any disadvantage.<\/p><p><br><\/p><p>As the survey is anonymous, once your responses have been submitted, it will not be possible\nto identify your individual data. Therefore, your data cannot be withdrawn after submission. We\nrespect your decision to withdraw, and it will not influence any ongoing relationships.<br><\/p><p><br><\/p>\n\t\n\t<p><b>Your Privacy:<\/b><\/p>\n<p><\/p>The study will collect demographic questionnaire responses, survey responses and interaction\ndata generated while you use the mock websites. Your name will not be collected as part of the\nresearch dataset, and the research data will be stored anonymously.<\/section><section class=\"participant-information\"><br><\/section><section class=\"participant-information\">Research data will be stored electronically in digital file formats on the University of Western\nAustralia\u2019s secure, password-protected OneDrive environment. Access will be restricted to the\nresearch team. The data will not be stored on personal devices or publicly accessible systems.<\/section><section class=\"participant-information\"><br><\/section><section class=\"participant-information\">The research data will be retained securely for 7 years following completion of the research\nproject, in accordance with applicable university requirements. At the end of the retention\nperiod, the data will be securely destroyed.<\/section><section class=\"participant-information\">&nbsp;\n<br>\n\n\t<p><b>Possible Risks and Risk Management Plan:<\/b><\/p>\n<p>There are no foreseeable risks in this study beyond those ordinarily experienced when using websites. The mock websites will not track participant browser data or any identifiable personal data.<\/p><br>\n\t\n\t<p><b>Contacts:<\/b><\/p>\n<p>If you would like to discuss any details of this study, please feel free to contact:<br>\nDipika Choudhury (Student Researcher) at 23779727@student.uwa.edu.au<br>\n\tDr Jin Hong (Research Supervisor) at jin.hong@uwa.edu.au<br><\/p><p><br><\/p>\n\t<p>-------\n<\/p>\n\t<p>Approval to conduct this research has been provided by the University of Western Australia, in accordance with its ethics review and approval procedures. Any person considering participation in this research project, or agreeing to participate, may raise any questions or issues with the\nresearchers at any time. In addition, any person not satisfied with the response of researchers may raise ethics issues or concerns, and may make any complaints about this research project by contacting the Human Ethics Office at the University of Western Australia on (08) 6488 3703 or by\nemailing to humanethics@uwa.edu.au. All research participants are entitled to retain a copy of any Participant Information Form and\/or Participant Consent Form relating to this research project.<br><\/p>\n\n<\/section>","DefaultChoices":false,"DataExportTag":"","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0 Participant Information and Consent Form Project Title: User interaction, Trust, and Privacy on...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID12"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"This Study has 3-4 sections depending on your randomly assigned experiment group. Before proceedi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p style=\"margin-bottom: 14px;\">This Study has 3-4 sections depending on your randomly assigned experiment group. Before proceeding to the experiment, please read the following.\r\n\r\n<br><\/p><p style=\"margin-bottom: 14px;\"><strong>Consent:<\/strong><\/p><p style=\"margin-bottom: 14px;\"><\/p>\n\n<p style=\"margin-bottom: 14px;\">\n  I can confirm the following:\n<\/p>\n\n<ol style=\"margin: 0 0 18px 22px;\n  padding: 0;\n  line-height: 1.6;\">\n  <li style=\"margin-bottom: 10px;\">\n    I am 18 years old or older.\n  <\/li>\n\n  <li style=\"margin-bottom: 10px;\">\n    I have read and understood the Participant Information Form.\n  <\/li>\n\n  <li style=\"margin-bottom: 10px;\">\n    I have had the opportunity to ask questions about this study.\n  <\/li>\n\n  <li style=\"margin-bottom: 10px;\">\n    I understand what my participation involves and what information will be recorded.\n  <\/li>\n\n  <li style=\"margin-bottom: 10px;\">\n    I understand that some details of this study will be explained after I complete the experiment.\n  <\/li>\n\n  <li style=\"margin-bottom: 10px;\">\n    I understand that participation is voluntary and I may discontinue participation at any time, without penalty.\n  <\/li>\n\n  <li style=\"margin-bottom: 10px;\">\n    I consent to participate in this research project.\n  <\/li>\n<\/ol>\n\n<p style=\"margin-top: 18px;\n  margin-bottom: 0;\">\n  <strong>\n    I understand that by selecting \u2018Yes\u2019, I agree to participate in this study.\n  <\/strong>\n<\/p>","DefaultChoices":false,"DataExportTag":"","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"This Study has 3-4 sections depending on your randomly assigned experiment group. Before proceedi...","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No (exits the survey)"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID13"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Section 2 You will now complete simple tasks across three mock websites. The website tasks will o...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1>Section 2<\/h1><br>\n\n  <p>\n    You will now complete simple tasks across three mock websites.\n  <\/p><br>\n\n  <p>\n\t  The website tasks will open in a new browser tab. <b>Please keep this survey open<\/b>.\n  <\/p><br>Once you have completed the tasks and reached the end of the experiment, return to this survey tab and continue to the final questionnaire.<br>\n\n  <p>\n    <\/p><p style=\"margin-top: 24px; text-align: center;\">\n    <a href=\"https:\/\/honours-privacy-experiment.bookreader667.workers.dev\/?pid=${e:\/\/Field\/ResponseID}&amp;condition=${e:\/\/Field\/condition}\" target=\"_blank\" rel=\"noopener\" style=\"display: inline-block;\n        padding: 12px 20px;\n        background: #27348b;\n        color: #ffffff;\n        text-decoration: none;\n        border-radius: 5px;\n        font-weight: 600;\">\n      Open Website Tasks\n    <\/a>\n  <\/p>\n\n  <p style=\"margin-top: 24px;\n    font-size: 0.95em;\"><\/p>","DefaultChoices":false,"DataExportTag":"","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Section 2 You will now complete simple tasks across three mock websites. The website tasks will o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID14"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Debrief Thank you for taking part in this study!\u00a0 This research looks at whether different ways o..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h1>Debrief<\/h1>\n<p><\/p><p>Thank you for taking part in this study!&nbsp;<\/p><p><br><\/p><p>This research looks at whether different ways of supporting online privacy decisions can help people make more informed choices without making websites harder or more frustrating to use.&nbsp;<\/p><p><br><\/p><p>In particular, the study compares two different approaches: providing privacy information that encourages people to think more carefully about how their information may be used, and automatically applying a privacy preference on their behalf.&nbsp;<\/p><p><br><\/p><p>We did not explain the full purpose of the study beforehand because it might have changed how closely you paid attention to the cookie banners and privacy features. We wanted your interactions to be as natural as possible.&nbsp;<\/p><p><br><\/p><p>Participants were randomly assigned to one of three groups: a standard cookie interface, an interface with extra privacy suggestions, or an interface that could automatically apply a saved cookie preference.&nbsp;<\/p><p><br><\/p><p>The website tasks themselves were not the main focus of the study. They were designed to give you something realistic to do while browsing, so we could observe how privacy decisions are made while attention is also focused on other content.&nbsp;<\/p><p><br><\/p><p>Some of the privacy messages shown on the mock websites were designed to simulate situations where a website may track or use information in ways that are not obvious to the user, or may not match the privacy choice the user selected. This was part of the experiment and did not involve real advertising or tracking.&nbsp;<\/p><p><br><\/p><p>The mock websites did not place real advertising or tracking cookies on your device. Only interactions relevant to the study, such as cookie choices, task responses, relevant clicks and time taken, were recorded.&nbsp;<\/p><p><br><\/p><p>Your responses will be analysed together with those of other participants, and individual participants will not be identified in the research findings.&nbsp;<\/p><p><br><\/p><p>Thank you so much again for your time and contribution to the study!<br><\/p>","DefaultChoices":false,"DataExportTag":"","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Debrief Thank you for taking part in this study!\u00a0 This research looks at whether different ways o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID15"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"For the following questions, use the scale to indicate how strongly you agree or disagree with ea...","TertiaryAttribute":null,"Payload":{"QuestionText":"For the following questions, use the scale to indicate how strongly you agree or disagree with each statement, where 1 means \u201cCompletely disagree\u201d and 5 means \u201cCompletely agree.\u201d","DefaultChoices":false,"DataExportTag":"","QuestionID":"QID16","QuestionType":"Slider","Selector":"NumberScale","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","ShowValue":true,"ShowStatements":true,"StartingValue":1,"NumScalePoints":5},"QuestionDescription":"For the following questions, use the scale to indicate how strongly you agree or disagree with ea...","Choices":{"1":{"Display":"1. I understood the privacy and cookie information shown during the website tasks."},"2":{"Display":"2. I understood what my cookie choices meant."},"3":{"Display":"3. I felt in control of my privacy choices during the website tasks."},"4":{"Display":"4. Managing my cookie preferences required little effort."},"5":{"Display":"5. I felt aware of what information the websites were tracking while I browsed."},"6":{"Display":"6. I felt confident that I understood the consequences of my cookie choices."}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"Labels":[],"ChoiceDataExportTags":false}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"I have completed the website tasks","TertiaryAttribute":null,"Payload":{"QuestionText":"I have completed the website tasks","DefaultChoices":false,"DataExportTag":"","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"I have completed the website tasks","Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID18","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID18\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID18","LeftOperand":"q:\/\/QID18\/SelectableChoice\/1","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">I have completed the website tasks<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":"MS_6FOfmtWdRsodsEP","subMessageID":"VE_FORCE_RESPONSE","libraryID":"UR_cx3B7rHE4ltDXMy","description":"Require response"}}}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID18"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"7. Which of the following can optional website tracking help a site learn about? Select all that...","TertiaryAttribute":null,"Payload":{"QuestionText":"7. Which of the following can optional website tracking help a site learn about? Select all that apply.","DefaultChoices":false,"DataExportTag":"","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"7. Which of the following can optional website tracking help a site learn about? Select all that...","Choices":{"1":{"Display":"Browsing activity"},"2":{"Display":"Device information"},"3":{"Display":"Approximate location"},"4":{"Display":"Passwords"},"5":{"Display":"Personal files stored on your computer"},"6":{"Display":"Interests inferred from browsing"},"7":{"Display":"I'm unsure"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID19"}},{"SurveyID":"SV_51nJDY3mK3sOJaS","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"1. What is your age?","TertiaryAttribute":null,"Payl